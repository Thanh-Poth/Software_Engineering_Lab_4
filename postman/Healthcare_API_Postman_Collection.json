          "raw": "{{baseUrl}}/api/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patients"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Marie\",\n  \"age\": 29\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
