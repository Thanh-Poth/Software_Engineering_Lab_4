    {
      "name": "Get appointment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {\n  pm.response.to.have.status(200)\n})\n\npm.test('Response is an array', () => {\n  pm.expect(pm.response.json()).to.be.an('array')\n})"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments",
          "host": [
            "{{baseUrl}}"
          ],
