    },
    {
      "name": "POST appointment-valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => {\n  pm.response.to.have.status(201)\n})\n\npm.test('Appointment matches the submitted data', () => {\n  const data = pm.response.json()\n  const sent = JSON.parse(pm.request.body.raw)\n\n  pm.expect(data.id).to.be.a('number')\n  pm.expect(data.doctor).to.equal(sent.doctor)\n  pm.expect(data.patient).to.equal(sent.patient)\n  pm.expect(data.date).to.equal(sent.date)\n})"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"doctor\": \"Dr. Lee\",\r\n  \"patient\": \"Alice Martin\",\r\n  \"date\": \"2026-12-10T10:00:00Z\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments"
          ]
        }
      },
      "response": []
    },
